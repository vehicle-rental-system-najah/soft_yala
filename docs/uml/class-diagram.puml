@startuml

skinparam classAttributeIconSize 0
skinparam packageStyle rectangle
skinparam shadowing false
skinparam linetype ortho

title Vehicle Rental Management System - Class Diagram

package "com.vehiclerental" {
    class Main {
        - LOGGER
        - SYSTEM_ZONE
        + main(args: String[]): void
    }
}

package "gui" {
    class VehicleRentalApp <<JavaFX Application>> {
        - primaryStage: Stage
        - setPrimaryStage(stage: Stage): void
        + start(stage: Stage): void
        + showLogin(): void
        + showDashboard(): void
        + showVehicles(): void
        + showCreateRental(): void
        + showReturnVehicle(): void
        - setScene(fileName: String, width: double, height: double): void
        + main(args: String[]): void
    }

    class GuiContext {
        - MANAGER_REPOSITORY: ManagerRepository
        - VEHICLE_REPOSITORY: VehicleRepository
        - RENTAL_REPOSITORY: RentalRepository
        - AUTH_SERVICE: AuthService
        - VEHICLE_CATALOG_SERVICE: VehicleCatalogService
        - RENTAL_SERVICE: RentalService
        - BILLING_SERVICE: BillingService
        - RETURN_SERVICE: ReturnService
        + getAuthService(): AuthService
        + getVehicleRepository(): VehicleRepository
        + getRentalRepository(): RentalRepository
        + getVehicleCatalogService(): VehicleCatalogService
        + getRentalService(): RentalService
        + getBillingService(): BillingService
        + getReturnService(): ReturnService
    }
}

package "gui.controller" {
    class LoginController <<Controller>>

    class DashboardController <<Controller>> {
        - pageTitle: Label
        - pageDescription: Label
        - availableVehiclesCountLabel: Label
        - activeRentalsCountLabel: Label
        - reminderCountLabel: Label
        - initialize(): void
        - refreshDashboardStats(): void
        - showDashboard(): void
        - showVehicles(): void
        - showRentals(): void
        - showReturns(): void
        - handleLogout(): void
    }

    class AvailableVehiclesController <<Controller>> {
        - searchField: TextField
        - vehicleCountLabel: Label
        - vehicleTable: TableView
        - vehicles: ObservableList
        - filteredVehicles: FilteredList
        - initialize(): void
        - configureColumns(): void
        - refreshVehicles(): void
        - filterVehicles(searchText: String): void
        - updateVehicleCount(): void
        - showDashboard(): void
        - showRentals(): void
        - showReturns(): void
        - handleLogout(): void
    }

    class CreateRentalController <<Controller>> {
        - rentalIdField: TextField
        - customerIdField: TextField
        - customerNameField: TextField
        - phoneField: TextField
        - emailField: TextField
        - ageField: TextField
        - licenseNumberField: TextField
        - licenseTypeComboBox: ComboBox
        - vehicleComboBox: ComboBox
        - startDatePicker: DatePicker
        - endDatePicker: DatePicker
        - initialize(): void
        - refreshVehicles(): void
        - handleCreateRental(): void
        - createLicense(): License
        - clearForm(): void
        - showDashboard(): void
        - showVehicles(): void
        - showReturns(): void
        - handleLogout(): void
    }

    class ReturnVehicleController <<Controller>> {
        - rentalComboBox: ComboBox
        - returnDatePicker: DatePicker
        - customerValueLabel: Label
        - vehicleValueLabel: Label
        - rentalPeriodValueLabel: Label
        - rentalCostValueLabel: Label
        - latePenaltyValueLabel: Label
        - totalAmountValueLabel: Label
        - invoiceBox: VBox
        - initialize(): void
        - refreshRentals(): void
        - updateRentalInformation(rental: Rental): void
        - handleReturnVehicle(): void
        - displayInvoice(invoice: Invoice): void
        - showDashboard(): void
        - showVehicles(): void
        - showRentals(): void
        - handleLogout(): void
    }
}

package "model" {
    abstract class Vehicle {
        - id: int
        - plateNumber: String
        - brand: String
        - model: String
        - dailyRate: double
        - status: VehicleStatus
        + getId(): int
        + getPlateNumber(): String
        + getBrand(): String
        + getModel(): String
        + getDailyRate(): double
        + getStatus(): VehicleStatus
        + setStatus(status: VehicleStatus): void
        + isAvailable(): boolean
        + getType(): String
    }

    class Car {
        + getType(): String
    }

    class Truck {
        - maxLoadKg: double
        + getMaxLoadKg(): double
        + getType(): String
    }

    class Motorcycle {
        - engineCapacity: int
        + getEngineCapacity(): int
        + getType(): String
    }

    class Van {
        - seats: int
        + getSeats(): int
        + getType(): String
    }

    class ElectricVehicle {
        - batteryLevel: int
        - batteryChecked: boolean
        + getBatteryLevel(): int
        + isBatteryChecked(): boolean
        + getType(): String
    }

    class Manager {
        - id: int
        - username: String
        - password: String
    }

    class Customer {
        - id: int
        - name: String
        - phone: String
        - email: String
        - age: int
        - license: License
    }

    class License {
        - licenseNumber: String
        - type: LicenseType
    }

    class Rental {
        - id: int
        - customer: Customer
        - vehicle: Vehicle
        - startDate: LocalDate
        - endDate: LocalDate
        - status: RentalStatus
        + isActive(): boolean
        + close(): void
    }

    class Invoice {
        - id: int
        - rental: Rental
        - returnDate: LocalDate
        - rentalCost: double
        - latePenalty: double
        - totalAmount: double
    }

    enum VehicleStatus {
        AVAILABLE
        RENTED
        MAINTENANCE
    }

    enum RentalStatus {
        ACTIVE
        CLOSED
        CANCELLED
    }

    enum LicenseType {
        REGULAR
        MOTORCYCLE
        TRUCK
    }

    Vehicle <|-- Car
    Vehicle <|-- Truck
    Vehicle <|-- Motorcycle
    Vehicle <|-- Van
    Vehicle <|-- ElectricVehicle

    Vehicle --> VehicleStatus
    Customer *-- License
    License --> LicenseType
    Rental --> RentalStatus
    Rental --> Customer
    Rental --> Vehicle
    Invoice --> Rental
}

package "repository" {
    interface ManagerRepository
    interface VehicleRepository
    interface RentalRepository

    class InMemoryManagerRepository
    class InMemoryVehicleRepository
    class InMemoryRentalRepository

    ManagerRepository <|.. InMemoryManagerRepository
    VehicleRepository <|.. InMemoryVehicleRepository
    RentalRepository <|.. InMemoryRentalRepository

    ManagerRepository --> Manager
    VehicleRepository --> Vehicle
    RentalRepository --> Rental
}

package "service" {
    class AuthService
    class VehicleCatalogService
    class RentalService
    class ReminderService
    class BillingService
    class ReturnService
}

package "validation" {
    interface RentalValidationStrategy

    class AvailabilityValidationStrategy
    class DurationValidationStrategy
    class TruckLicenseValidationStrategy
    class MotorcycleAgeValidationStrategy
    class ElectricBatteryValidationStrategy

    RentalValidationStrategy <|.. AvailabilityValidationStrategy
    RentalValidationStrategy <|.. DurationValidationStrategy
    RentalValidationStrategy <|.. TruckLicenseValidationStrategy
    RentalValidationStrategy <|.. MotorcycleAgeValidationStrategy
    RentalValidationStrategy <|.. ElectricBatteryValidationStrategy
}

package "pricing" {
    interface PricingStrategy

    class DefaultPricingStrategy
    class CarPricingStrategy
    class TruckPricingStrategy
    class ElectricVehiclePricingStrategy

    interface LatePenaltyStrategy
    class DefaultLatePenaltyStrategy

    PricingStrategy <|.. DefaultPricingStrategy
    PricingStrategy <|.. CarPricingStrategy
    PricingStrategy <|.. TruckPricingStrategy
    PricingStrategy <|.. ElectricVehiclePricingStrategy

    LatePenaltyStrategy <|.. DefaultLatePenaltyStrategy
}

package "notification" {
    interface NotificationService
    class EmailNotificationService

    NotificationService <|.. EmailNotificationService
}

package "observer" {
    interface RentalObserver
    class RentalExpiryObserver

    RentalObserver <|.. RentalExpiryObserver
}

package "util" {
    interface DateTimeProvider
    class SystemDateTimeProvider

    DateTimeProvider <|.. SystemDateTimeProvider
}

AuthService --> ManagerRepository
VehicleCatalogService --> VehicleRepository

RentalService --> VehicleRepository
RentalService --> RentalRepository
RentalService "1" o-- "*" RentalValidationStrategy
RentalService --> Rental
RentalService --> Customer
RentalService --> Vehicle

ReminderService --> RentalRepository
ReminderService --> DateTimeProvider
ReminderService "1" o-- "*" RentalObserver

BillingService --> PricingStrategy
BillingService --> LatePenaltyStrategy
BillingService --> Invoice

ReturnService --> RentalRepository
ReturnService --> BillingService
ReturnService --> Invoice

RentalExpiryObserver --> NotificationService

Main --> AuthService
Main --> VehicleCatalogService
Main --> RentalService
Main --> ReminderService
Main --> BillingService
Main --> ReturnService

GuiContext --> ManagerRepository
GuiContext --> VehicleRepository
GuiContext --> RentalRepository
GuiContext --> AuthService
GuiContext --> VehicleCatalogService
GuiContext --> RentalService
GuiContext --> BillingService
GuiContext --> ReturnService
GuiContext --> RentalValidationStrategy

VehicleRentalApp ..> LoginController : loads
VehicleRentalApp ..> DashboardController : loads
VehicleRentalApp ..> AvailableVehiclesController : loads
VehicleRentalApp ..> CreateRentalController : loads
VehicleRentalApp ..> ReturnVehicleController : loads

LoginController --> GuiContext
LoginController --> VehicleRentalApp

DashboardController --> GuiContext
DashboardController --> VehicleRentalApp
DashboardController --> Rental

AvailableVehiclesController --> GuiContext
AvailableVehiclesController --> VehicleRentalApp
AvailableVehiclesController --> Vehicle

CreateRentalController --> GuiContext
CreateRentalController --> VehicleRentalApp
CreateRentalController --> Customer
CreateRentalController --> License
CreateRentalController --> LicenseType
CreateRentalController --> Vehicle
CreateRentalController --> Rental

ReturnVehicleController --> GuiContext
ReturnVehicleController --> VehicleRentalApp
ReturnVehicleController --> Rental
ReturnVehicleController --> Invoice

@enduml