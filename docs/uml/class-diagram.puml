@startuml

skinparam classAttributeIconSize 0
skinparam packageStyle rectangle
skinparam shadowing false
skinparam linetype ortho

title Vehicle Rental Management System - Class Diagram

package "com.vehiclerental" {
    class Main {
        - LOGGER
        - SYSTEM_ZONE
        + main(args: String[]): void
    }
}

package "model" {
    abstract class Vehicle {
        - id: int
        - plateNumber: String
        - brand: String
        - model: String
        - dailyRate: double
        - status: VehicleStatus
        + getId(): int
        + getPlateNumber(): String
        + getBrand(): String
        + getModel(): String
        + getDailyRate(): double
        + getStatus(): VehicleStatus
        + setStatus(status: VehicleStatus): void
        + isAvailable(): boolean
        + getType(): String
    }

    class Car {
        + getType(): String
    }

    class Truck {
        - maxLoadKg: double
        + getMaxLoadKg(): double
        + getType(): String
    }

    class Motorcycle {
        - engineCapacity: int
        + getEngineCapacity(): int
        + getType(): String
    }

    class Van {
        - seats: int
        + getSeats(): int
        + getType(): String
    }

    class ElectricVehicle {
        - batteryLevel: int
        - batteryChecked: boolean
        + getBatteryLevel(): int
        + isBatteryChecked(): boolean
        + getType(): String
    }

    class Manager {
        - id: int
        - username: String
        - password: String
    }

    class Customer {
        - id: int
        - name: String
        - phone: String
        - email: String
        - age: int
        - license: License
    }

    class License {
        - licenseNumber: String
        - type: LicenseType
    }

    class Rental {
        - id: int
        - customer: Customer
        - vehicle: Vehicle
        - startDate: LocalDate
        - endDate: LocalDate
        - status: RentalStatus
    }

    class Invoice {
        - id: int
        - rental: Rental
        - returnDate: LocalDate
        - rentalCost: double
        - latePenalty: double
        - totalAmount: double
    }

    enum VehicleStatus {
        AVAILABLE
        RENTED
        MAINTENANCE
    }

    enum RentalStatus {
        ACTIVE
        CLOSED
        CANCELLED
    }

    enum LicenseType {
        REGULAR
        MOTORCYCLE
        TRUCK
    }

    Vehicle <|-- Car
    Vehicle <|-- Truck
    Vehicle <|-- Motorcycle
    Vehicle <|-- Van
    Vehicle <|-- ElectricVehicle

    Vehicle --> VehicleStatus
    Customer *-- License
    License --> LicenseType
    Rental --> RentalStatus
    Rental --> Customer
    Rental --> Vehicle
    Invoice --> Rental
}

package "repository" {
    interface ManagerRepository
    interface VehicleRepository
    interface RentalRepository

    class InMemoryManagerRepository
    class InMemoryVehicleRepository
    class InMemoryRentalRepository

    ManagerRepository <|.. InMemoryManagerRepository
    VehicleRepository <|.. InMemoryVehicleRepository
    RentalRepository <|.. InMemoryRentalRepository

    ManagerRepository --> Manager
    VehicleRepository --> Vehicle
    RentalRepository --> Rental
}

package "service" {
    class AuthService
    class VehicleCatalogService
    class RentalService
    class ReminderService
    class BillingService
    class ReturnService
}

package "validation" {
    interface RentalValidationStrategy

    class AvailabilityValidationStrategy
    class DurationValidationStrategy
    class TruckLicenseValidationStrategy
    class MotorcycleAgeValidationStrategy
    class ElectricBatteryValidationStrategy

    RentalValidationStrategy <|.. AvailabilityValidationStrategy
    RentalValidationStrategy <|.. DurationValidationStrategy
    RentalValidationStrategy <|.. TruckLicenseValidationStrategy
    RentalValidationStrategy <|.. MotorcycleAgeValidationStrategy
    RentalValidationStrategy <|.. ElectricBatteryValidationStrategy
}

package "pricing" {
    interface PricingStrategy

    class DefaultPricingStrategy
    class CarPricingStrategy
    class TruckPricingStrategy
    class ElectricVehiclePricingStrategy

    interface LatePenaltyStrategy
    class DefaultLatePenaltyStrategy

    PricingStrategy <|.. DefaultPricingStrategy
    PricingStrategy <|.. CarPricingStrategy
    PricingStrategy <|.. TruckPricingStrategy
    PricingStrategy <|.. ElectricVehiclePricingStrategy

    LatePenaltyStrategy <|.. DefaultLatePenaltyStrategy
}

package "notification" {
    interface NotificationService
    class EmailNotificationService

    NotificationService <|.. EmailNotificationService
}

package "observer" {
    interface RentalObserver
    class RentalExpiryObserver

    RentalObserver <|.. RentalExpiryObserver
}

package "util" {
    interface DateTimeProvider
    class SystemDateTimeProvider

    DateTimeProvider <|.. SystemDateTimeProvider
}

AuthService --> ManagerRepository
VehicleCatalogService --> VehicleRepository

RentalService --> VehicleRepository
RentalService --> RentalRepository
RentalService "1" o-- "*" RentalValidationStrategy
RentalService --> Rental
RentalService --> Customer
RentalService --> Vehicle

ReminderService --> RentalRepository
ReminderService --> DateTimeProvider
ReminderService "1" o-- "*" RentalObserver

BillingService --> PricingStrategy
BillingService --> LatePenaltyStrategy
BillingService --> Invoice

ReturnService --> RentalRepository
ReturnService --> BillingService
ReturnService --> Invoice

RentalExpiryObserver --> NotificationService

Main --> AuthService
Main --> VehicleCatalogService
Main --> RentalService
Main --> ReminderService
Main --> BillingService
Main --> ReturnService

@enduml