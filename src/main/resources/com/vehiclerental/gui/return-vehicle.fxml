<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<BorderPane prefHeight="760.0"
            prefWidth="1280.0"
            styleClass="dashboard-root"
            xmlns="http://javafx.com/javafx/17"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.vehiclerental.gui.controller.ReturnVehicleController">

    <left>
        <VBox prefWidth="255.0"
              spacing="8.0"
              styleClass="sidebar">

            <padding>
                <Insets top="28.0"
                        right="20.0"
                        bottom="24.0"
                        left="20.0"/>
            </padding>

            <HBox alignment="CENTER_LEFT" spacing="12.0">
                <StackPane prefHeight="44.0"
                           prefWidth="44.0"
                           styleClass="sidebar-logo">

                    <Label text="VR"
                           styleClass="sidebar-logo-text"/>
                </StackPane>

                <VBox spacing="1.0">
                    <Label text="VELOCITY"
                           styleClass="sidebar-brand"/>

                    <Label text="Rental System"
                           styleClass="sidebar-brand-small"/>
                </VBox>
            </HBox>

            <Region prefHeight="35.0"/>

            <Label text="MANAGEMENT"
                   styleClass="menu-section"/>

            <Button maxWidth="Infinity"
                    onAction="#showDashboard"
                    text="Dashboard"
                    styleClass="menu-button"/>

            <Button maxWidth="Infinity"
                    onAction="#showVehicles"
                    text="Available Vehicles"
                    styleClass="menu-button"/>

            <Button maxWidth="Infinity"
                    onAction="#showRentals"
                    text="Create Rental"
                    styleClass="menu-button"/>

            <Button maxWidth="Infinity"
                    text="Return Vehicle"
                    styleClass="menu-button-active"/>

            <Region VBox.vgrow="ALWAYS"/>

            <VBox spacing="4.0"
                  styleClass="manager-card">

                <Label text="Signed in as"
                       styleClass="manager-label"/>

                <Label text="System Manager"
                       styleClass="manager-name"/>
            </VBox>

            <Button maxWidth="Infinity"
                    onAction="#handleLogout"
                    text="Sign Out"
                    styleClass="logout-button"/>
        </VBox>
    </left>

    <top>
        <HBox alignment="CENTER_LEFT"
              spacing="18.0"
              styleClass="top-bar">

            <padding>
                <Insets top="22.0"
                        right="38.0"
                        bottom="22.0"
                        left="38.0"/>
            </padding>

            <VBox spacing="3.0">
                <Label text="Return Vehicle"
                       styleClass="page-title"/>

                <Label text="Close an active rental and generate the customer invoice."
                       styleClass="page-subtitle"/>
            </VBox>

            <Region HBox.hgrow="ALWAYS"/>

            <VBox alignment="CENTER_RIGHT" spacing="2.0">
                <Label text="Vehicle Rental System"
                       styleClass="top-manager"/>

                <Label text="Returns and Billing"
                       styleClass="top-role"/>
            </VBox>

            <StackPane prefHeight="45.0"
                       prefWidth="45.0"
                       styleClass="manager-avatar">

                <Label text="M"
                       styleClass="manager-avatar-text"/>
            </StackPane>
        </HBox>
    </top>

    <center>
        <ScrollPane fitToWidth="true"
                    hbarPolicy="NEVER"
                    styleClass="rental-scroll-pane">

            <content>
                <VBox spacing="22.0"
                      styleClass="vehicles-page">

                    <padding>
                        <Insets top="30.0"
                                right="38.0"
                                bottom="35.0"
                                left="38.0"/>
                    </padding>

                    <VBox spacing="22.0"
                          styleClass="vehicle-table-card">

                        <padding>
                            <Insets top="28.0"
                                    right="30.0"
                                    bottom="30.0"
                                    left="30.0"/>
                        </padding>

                        <VBox spacing="4.0">
                            <Label text="Active Rental"
                                   styleClass="card-title"/>

                            <Label text="Select the rental and enter the actual return date."
                                   styleClass="card-description"/>
                        </VBox>

                        <Separator/>

                        <VBox spacing="7.0">
                            <Label text="Select Active Rental"
                                   styleClass="form-label"/>

                            <HBox spacing="12.0">
                                <ComboBox fx:id="rentalComboBox"
                                          maxWidth="Infinity"
                                          prefWidth="650.0"
                                          HBox.hgrow="ALWAYS"
                                          promptText="Select an active rental"
                                          styleClass="vehicle-search-field"/>

                                <Button onAction="#refreshRentals"
                                        text="Refresh"
                                        styleClass="action-button"/>
                            </HBox>
                        </VBox>

                        <GridPane hgap="22.0"
                                  vgap="16.0">

                            <columnConstraints>
                                <ColumnConstraints percentWidth="50.0"/>
                                <ColumnConstraints percentWidth="50.0"/>
                            </columnConstraints>

                            <VBox spacing="7.0"
                                  GridPane.columnIndex="0"
                                  GridPane.rowIndex="0">

                                <Label text="Customer"
                                       styleClass="form-label"/>

                                <Label fx:id="customerValueLabel"
                                       text="-"
                                       styleClass="card-description"/>
                            </VBox>

                            <VBox spacing="7.0"
                                  GridPane.columnIndex="1"
                                  GridPane.rowIndex="0">

                                <Label text="Vehicle"
                                       styleClass="form-label"/>

                                <Label fx:id="vehicleValueLabel"
                                       text="-"
                                       styleClass="card-description"/>
                            </VBox>

                            <VBox spacing="7.0"
                                  GridPane.columnIndex="0"
                                  GridPane.rowIndex="1">

                                <Label text="Rental Period"
                                       styleClass="form-label"/>

                                <Label fx:id="rentalPeriodValueLabel"
                                       text="-"
                                       styleClass="card-description"/>
                            </VBox>

                            <VBox spacing="7.0"
                                  GridPane.columnIndex="1"
                                  GridPane.rowIndex="1">

                                <Label text="Actual Return Date"
                                       styleClass="form-label"/>

                                <DatePicker fx:id="returnDatePicker"
                                            maxWidth="Infinity"
                                            styleClass="vehicle-search-field"/>
                            </VBox>
                        </GridPane>

                        <HBox alignment="CENTER_RIGHT"
                              spacing="12.0">

                            <Button onAction="#showDashboard"
                                    text="Cancel"
                                    styleClass="action-button"/>

                            <Button onAction="#handleReturnVehicle"
                                    text="Return Vehicle"
                                    styleClass="action-button-primary"/>
                        </HBox>
                    </VBox>

                    <VBox fx:id="invoiceBox"
                          spacing="18.0"
                          styleClass="content-card">

                        <Label text="Generated Invoice"
                               styleClass="card-title"/>

                        <Label text="The vehicle was returned and the rental was closed."
                               styleClass="card-description"/>

                        <Separator/>

                        <GridPane hgap="22.0"
                                  vgap="15.0">

                            <columnConstraints>
                                <ColumnConstraints percentWidth="50.0"/>
                                <ColumnConstraints percentWidth="50.0"/>
                            </columnConstraints>

                            <Label text="Rental Cost"
                                   styleClass="form-label"
                                   GridPane.columnIndex="0"
                                   GridPane.rowIndex="0"/>

                            <Label fx:id="rentalCostValueLabel"
                                   text="0.00"
                                   styleClass="stat-number"
                                   GridPane.columnIndex="1"
                                   GridPane.rowIndex="0"/>

                            <Label text="Late Penalty"
                                   styleClass="form-label"
                                   GridPane.columnIndex="0"
                                   GridPane.rowIndex="1"/>

                            <Label fx:id="latePenaltyValueLabel"
                                   text="0.00"
                                   styleClass="stat-number"
                                   GridPane.columnIndex="1"
                                   GridPane.rowIndex="1"/>

                            <Label text="Total Amount"
                                   styleClass="form-label"
                                   GridPane.columnIndex="0"
                                   GridPane.rowIndex="2"/>

                            <Label fx:id="totalAmountValueLabel"
                                   text="0.00"
                                   styleClass="stat-number"
                                   GridPane.columnIndex="1"
                                   GridPane.rowIndex="2"/>
                        </GridPane>
                    </VBox>
                </VBox>
            </content>
        </ScrollPane>
    </center>

</BorderPane>