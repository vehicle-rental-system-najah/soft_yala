<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<BorderPane prefHeight="720.0"
            prefWidth="1180.0"
            styleClass="app-root"
            xmlns="http://javafx.com/javafx/17"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.vehiclerental.gui.controller.LoginController">

    <left>
        <VBox alignment="CENTER_LEFT"
              prefWidth="540.0"
              spacing="24.0"
              styleClass="brand-panel">

            <padding>
                <Insets bottom="80.0"
                        left="64.0"
                        right="64.0"
                        top="80.0"/>
            </padding>

            <HBox alignment="CENTER_LEFT" spacing="14.0">
                <StackPane prefHeight="58.0"
                           prefWidth="58.0"
                           styleClass="brand-logo">
                    <Label text="VR" styleClass="brand-logo-text"/>
                </StackPane>

                <VBox spacing="2.0">
                    <Label text="VELOCITY"
                           styleClass="brand-name"/>
                    <Label text="RENTAL MANAGEMENT"
                           styleClass="brand-subname"/>
                </VBox>
            </HBox>

            <Region prefHeight="38.0"/>

            <Label text="Manage every rental&#10;with confidence."
                   wrapText="true"
                   styleClass="hero-title"/>

            <Label text="A modern vehicle rental management system designed to simplify vehicle availability, rentals, returns and billing."
                   maxWidth="390.0"
                   wrapText="true"
                   styleClass="hero-description"/>

            <Region prefHeight="24.0"/>

            <VBox spacing="15.0">
                <HBox alignment="CENTER_LEFT" spacing="13.0">
                    <Label text="✓" styleClass="feature-icon"/>
                    <Label text="Real-time vehicle availability"
                           styleClass="feature-text"/>
                </HBox>

                <HBox alignment="CENTER_LEFT" spacing="13.0">
                    <Label text="✓" styleClass="feature-icon"/>
                    <Label text="Reliable rental validation"
                           styleClass="feature-text"/>
                </HBox>

                <HBox alignment="CENTER_LEFT" spacing="13.0">
                    <Label text="✓" styleClass="feature-icon"/>
                    <Label text="Automated billing and returns"
                           styleClass="feature-text"/>
                </HBox>
            </VBox>

            <Region VBox.vgrow="ALWAYS"/>

            <Label text="Vehicle Rental Management System"
                   styleClass="brand-footer"/>
        </VBox>
    </left>

    <center>
        <StackPane styleClass="login-area">
            <VBox alignment="CENTER_LEFT"
                  maxWidth="410.0"
                  spacing="18.0"
                  styleClass="login-card">

                <Label text="Welcome back"
                       styleClass="login-title"/>

                <Label text="Sign in to continue to your dashboard"
                       styleClass="login-subtitle"/>

                <Region prefHeight="10.0"/>

                <Label text="Username"
                       styleClass="field-label"/>

                <TextField fx:id="usernameField"
                           promptText="Enter your username"
                           styleClass="form-field"/>

                <Label text="Password"
                       styleClass="field-label"/>

                <PasswordField fx:id="passwordField"
                               promptText="Enter your password"
                               styleClass="form-field"/>

                <Label fx:id="statusLabel"
                       minHeight="22.0"
                       wrapText="true"
                       styleClass="status-label"/>

                <Button fx:id="loginButton"
                        defaultButton="true"
                        maxWidth="Infinity"
                        onAction="#handleLogin"
                        text="Sign In"
                        styleClass="primary-button"/>

                <HBox alignment="CENTER">
                    <Label text="Secure access for authorized managers"
                           styleClass="secure-text"/>
                </HBox>
            </VBox>
        </StackPane>
    </center>

</BorderPane>