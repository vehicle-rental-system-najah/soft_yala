<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<BorderPane prefHeight="760.0"
            prefWidth="1280.0"
            styleClass="dashboard-root"
            xmlns="http://javafx.com/javafx/17"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.vehiclerental.gui.controller.DashboardController">

    <left>
        <VBox prefWidth="255.0"
              spacing="8.0"
              styleClass="sidebar">

            <padding>
                <Insets top="28.0"
                        right="20.0"
                        bottom="24.0"
                        left="20.0"/>
            </padding>

            <HBox alignment="CENTER_LEFT" spacing="12.0">
                <StackPane prefHeight="44.0"
                           prefWidth="44.0"
                           styleClass="sidebar-logo">
                    <Label text="VR"
                           styleClass="sidebar-logo-text"/>
                </StackPane>

                <VBox spacing="1.0">
                    <Label text="VELOCITY"
                           styleClass="sidebar-brand"/>
                    <Label text="Rental System"
                           styleClass="sidebar-brand-small"/>
                </VBox>
            </HBox>

            <Region prefHeight="35.0"/>

            <Label text="MANAGEMENT"
                   styleClass="menu-section"/>

            <Button maxWidth="Infinity"
                    onAction="#showDashboard"
                    text="Dashboard"
                    styleClass="menu-button-active"/>

            <Button maxWidth="Infinity"
                    onAction="#showVehicles"
                    text="Available Vehicles"
                    styleClass="menu-button"/>

            <Button maxWidth="Infinity"
                    onAction="#showRentals"
                    text="Create Rental"
                    styleClass="menu-button"/>

            <Button maxWidth="Infinity"
                    onAction="#showReturns"
                    text="Return Vehicle"
                    styleClass="menu-button"/>

            <Region VBox.vgrow="ALWAYS"/>

            <VBox spacing="4.0"
                  styleClass="manager-card">
                <Label text="Signed in as"
                       styleClass="manager-label"/>
                <Label text="System Manager"
                       styleClass="manager-name"/>
            </VBox>

            <Button maxWidth="Infinity"
                    onAction="#handleLogout"
                    text="Sign Out"
                    styleClass="logout-button"/>
        </VBox>
    </left>

    <top>
        <HBox alignment="CENTER_LEFT"
              spacing="18.0"
              styleClass="top-bar">

            <padding>
                <Insets top="22.0"
                        right="38.0"
                        bottom="22.0"
                        left="38.0"/>
            </padding>

            <VBox spacing="3.0">
                <Label fx:id="pageTitle"
                       text="Dashboard"
                       styleClass="page-title"/>

                <Label fx:id="pageDescription"
                       text="Overview of your vehicle rental operations."
                       styleClass="page-subtitle"/>
            </VBox>

            <Region HBox.hgrow="ALWAYS"/>

            <VBox alignment="CENTER_RIGHT" spacing="2.0">
                <Label text="Vehicle Rental System"
                       styleClass="top-manager"/>
                <Label text="Operational Dashboard"
                       styleClass="top-role"/>
            </VBox>

            <StackPane prefHeight="45.0"
                       prefWidth="45.0"
                       styleClass="manager-avatar">
                <Label text="M"
                       styleClass="manager-avatar-text"/>
            </StackPane>
        </HBox>
    </top>

    <center>
        <VBox spacing="28.0"
              styleClass="dashboard-content">

            <padding>
                <Insets top="30.0"
                        right="38.0"
                        bottom="35.0"
                        left="38.0"/>
            </padding>

            <FlowPane hgap="20.0"
                      vgap="20.0">

                <VBox prefHeight="150.0"
                      prefWidth="215.0"
                      spacing="10.0"
                      styleClass="stat-card">

                    <HBox alignment="CENTER_LEFT">
                        <Label text="AVAILABLE"
                               styleClass="stat-label"/>
                        <Region HBox.hgrow="ALWAYS"/>
                        <Label text="A"
                               styleClass="stat-icon-green"/>
                    </HBox>

                    <Label text="6"
                           styleClass="stat-number"/>

                    <Label text="Vehicles ready to rent"
                           styleClass="stat-description"/>
                </VBox>

                <VBox prefHeight="150.0"
                      prefWidth="215.0"
                      spacing="10.0"
                      styleClass="stat-card">

                    <HBox alignment="CENTER_LEFT">
                        <Label text="ACTIVE RENTALS"
                               styleClass="stat-label"/>
                        <Region HBox.hgrow="ALWAYS"/>
                        <Label text="R"
                               styleClass="stat-icon-blue"/>
                    </HBox>

                    <Label text="0"
                           styleClass="stat-number"/>

                    <Label text="Currently rented vehicles"
                           styleClass="stat-description"/>
                </VBox>

                <VBox prefHeight="150.0"
                      prefWidth="215.0"
                      spacing="10.0"
                      styleClass="stat-card">

                    <HBox alignment="CENTER_LEFT">
                        <Label text="REMINDERS"
                               styleClass="stat-label"/>
                        <Region HBox.hgrow="ALWAYS"/>
                        <Label text="N"
                               styleClass="stat-icon-orange"/>
                    </HBox>

                    <Label text="0"
                           styleClass="stat-number"/>

                    <Label text="Rentals close to expiry"
                           styleClass="stat-description"/>
                </VBox>

                <VBox prefHeight="150.0"
                      prefWidth="215.0"
                      spacing="10.0"
                      styleClass="stat-card">

                    <HBox alignment="CENTER_LEFT">
                        <Label text="SYSTEM STATUS"
                               styleClass="stat-label"/>
                        <Region HBox.hgrow="ALWAYS"/>
                        <Label text="✓"
                               styleClass="stat-icon-green"/>
                    </HBox>

                    <Label text="Online"
                           styleClass="stat-status"/>

                    <Label text="All services operational"
                           styleClass="stat-description"/>
                </VBox>
            </FlowPane>

            <HBox spacing="22.0">

                <VBox HBox.hgrow="ALWAYS"
                      spacing="17.0"
                      styleClass="content-card">

                    <Label text="Quick Actions"
                           styleClass="card-title"/>

                    <Label text="Choose an action to manage your rental operations."
                           styleClass="card-description"/>

                    <FlowPane hgap="14.0"
                              vgap="14.0">

                        <Button onAction="#showVehicles"
                                text="Browse Vehicles"
                                styleClass="action-button"/>

                        <Button onAction="#showRentals"
                                text="Create Rental"
                                styleClass="action-button-primary"/>

                        <Button onAction="#showReturns"
                                text="Return Vehicle"
                                styleClass="action-button"/>
                    </FlowPane>
                </VBox>

                <VBox prefWidth="330.0"
                      spacing="16.0"
                      styleClass="content-card">

                    <Label text="System Overview"
                           styleClass="card-title"/>

                    <HBox alignment="CENTER_LEFT" spacing="10.0">
                        <Label text="✓"
                               styleClass="overview-check"/>
                        <Label text="Vehicle catalogue ready"
                               styleClass="overview-text"/>
                    </HBox>

                    <HBox alignment="CENTER_LEFT" spacing="10.0">
                        <Label text="✓"
                               styleClass="overview-check"/>
                        <Label text="Rental validation enabled"
                               styleClass="overview-text"/>
                    </HBox>

                    <HBox alignment="CENTER_LEFT" spacing="10.0">
                        <Label text="✓"
                               styleClass="overview-check"/>
                        <Label text="Billing services active"
                               styleClass="overview-text"/>
                    </HBox>

                    <HBox alignment="CENTER_LEFT" spacing="10.0">
                        <Label text="✓"
                               styleClass="overview-check"/>
                        <Label text="Notifications configured"
                               styleClass="overview-text"/>
                    </HBox>
                </VBox>
            </HBox>
        </VBox>
    </center>

</BorderPane>